// Sportsun Factory ERP — schema
// Product is the single master (Catalog + Style merged). Style is retained but
// deprecated (seed-time read-model only); the /styles route is retired.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum VendorKind {
  EXTERNAL
  INHOUSE
}

enum FabricUnit {
  KG
  MTR
}

// Knitted fabric is held either OPEN (flat) or TUBE (circular). Master default.
enum FabricForm {
  OPEN
  TUBE
}

enum JobStatus {
  // Change 38 Part A — a card that exists but has posted NOTHING: no stock movement, no
  // ledger row, no trim plan, no challan, and no SI number. It holds typed details so a
  // half-finished card survives someone walking away from the desk, and it is excluded
  // from every production count (see POSTED in lib/job-scope.ts). Saving it runs the
  // normal posting exactly once and flips it to ACTIVE.
  DRAFT
  ACTIVE
  CLOSED
}

// "Overdue" is derived (isOverdue from plannedEtd), not stored.
// The real shop-floor flow (Change 12, Part B). STITCHING is kept valid for legacy
// rows and normalised to ON_MACHINE on read (see normStage in job-labels.ts).
enum JobStage {
  FABRIC_AWAITED
  CUTTING
  ON_MACHINE
  FINISHING
  DISPATCH
  STITCHING
}

enum MovementType {
  ISSUE
  RECEIPT
}

// Why a dispatch/production row left stock (Change 10, Part H).
enum DispatchReason {
  ORDER
  SALE
  OTHER
}

// Materials challan direction (Change 11).
enum ChallanDirection {
  INWARD // from a Supplier -> our master stock (adds)
  OUTWARD // to a Vendor -> from our master stock (subtracts)
}

enum ChallanStatus {
  DRAFT // editable
  LOCKED // numbered & posted to inventory; no further line edits
}

// Materials challan kind (Change 17, Part C) — derived from the lines on save/lock.
// One document model; null for legacy rows (derived lazily in views).
enum ChallanKind {
  FABRIC // fabric-only lines
  TRIM // trim-only lines
  COMBINED // both fabric and trim lines
}

enum Role {
  ADMIN
  STAFF
  VENDOR
  TRIMS // column/scope-limited persona (e.g. Satya — trims only)
}

enum ProductStatus {
  ACTIVE
  NEW_ARTICLE
  FUTURE_PLAN
  DISCONTINUED
  IN_PROCESS
}

enum ProductionStatus {
  ORDER_GIVEN
  IN_PRODUCTION
  COMPLETED
}

// How a BOM line's trim is consumed against the size×colour matrix.
enum BomDimension {
  COLOR // explode × that colour's cut qty
  SIZE // explode × that size's cut qty
  FLAT // same on every piece (× total cut qty)
}

enum SupplierType {
  CHINA
  IMPORTER
  AGENT
  MANUFACTURER
}

// The 7 head trim categories (unified from the fragmented trim databases).
enum TrimCategory {
  BUTTON
  ZIP
  TAG
  CARDBOARD
  MASTERPACK
  LABEL
  POLYBAG // packaging / panni
  OTHER
}

enum TrimStatus {
  ACTIVE
  PLANNING
  DISCONTINUED
}

enum FabricOrderStatus {
  // Change 38 Part A — same contract as JobStatus.DRAFT: typed but not yet an order.
  // Shared by FabricOrder and TrimOrder.
  DRAFT
  PLANNING
  SAMPLE_PENDING
  ORDER_PLACED
  RECEIVED
  DISCARDED
}

enum SamplingStatus {
  PLANNING
  DESIGN_FABRIC_PENDING
  SAMPLE_ORDERED
  READY
}

enum ProductionLot {
  OLD_CUT_SIZE
  NEW_LOT
}

// ── Change 36 Part 1 — the operational money layer ──
// This is what work is WORTH and what is still OWED, derived from documents ssfact
// already owns. It is NOT statutory accounting: the books stay in Tally, this exports
// to it. Payables only — sales receivables belong to the B2B app.
enum PartyRateType {
  PER_PIECE
  PER_DOZEN
  LUMPSUM
}

enum LedgerKind {
  WORK_BILL
  PO_BILL
  PAYMENT
  ADVANCE
  ADJUSTMENT
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model Vendor {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  kind              VendorKind         @default(EXTERNAL)
  active            Boolean            @default(true)
  // Change 36 Part 1: the default job-work rate for this vendor. Owner-only on read
  // (canSeeCost). Null means no rate agreed — nothing is billed rather than billed at 0.
  jobRateType       PartyRateType?
  jobRate           Float?
  // Change 36 Part 2: a vendor had no phone or email at all, so "card routed to vendor"
  // had nowhere to send. Nullable — an unreachable vendor simply gets the in-app row.
  phone             String?
  email             String?
  // Change 36 Part 4: the ONE entered number in capacity planning — everything else is
  // derived. No default: 0 would make days-to-clear Infinity for every legacy vendor,
  // and null honestly means "not set", which suppresses the projection rather than
  // inventing one.
  dailyCapacityPcs  Float?
  capacityNote      String?
  ledgerEntries     PartyLedgerEntry[]
  jobCards          JobCard[]
  stitchAssignments StitchAssignment[]
  materialChallans  MaterialChallan[]
  cuttingLayers     CuttingLayer[] // Change 14: a layer is issued to a vendor
  reworks           Rework[]
  samples           Sample[]
  finishingJobs     FinishingJob[] // Change 20: print/emb/wash job-work given to this vendor
}

// Change 36 Part 1 — the party ledger. APPEND-ONLY and one-directional per row.
//
// ★ Money is DERIVED from documents, never hand-typed as a floating number. So this
// table deliberately does NOT hold the bills: vendor dues are Σ(dispatched pieces ×
// rate) and supplier payables are Σ(locked inward challan qty × PO rate), both computed
// live in getPartyStatement. If a derived bill and a stored WORK_BILL row both existed
// they could disagree, and the stored one would win by accident.
//
// What IS stored is the only thing that cannot be derived: what was actually paid.
// Nothing is ever deleted or edited — a mistake is corrected by posting its inverse,
// so the trail stays intact.
model PartyLedgerEntry {
  id        Int             @id @default(autoincrement())
  at        DateTime        @default(now())
  kind      LedgerKind
  direction LedgerDirection
  amount    Float
  note      String?

  // Whose account this sits on — exactly one of the two is set.
  vendor     Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorId   Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId Int?

  // Provenance, all optional: which document this payment was made against, when known.
  jobCardId       Int?
  dispatchEventId Int?
  finishingJobId  Int?
  challanId       Int?

  // The rate in force when this was posted, snapshotted so a later rate change can
  // never restate a settled bill.
  rateAtPosting Float?

  createdBy   User? @relation("PartyLedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([vendorId])
  @@index([supplierId])
  @@index([at])
}

model CuttingMaster {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  active        Boolean        @default(true)
  jobCards      JobCard[]
  cuttingLayers CuttingLayer[]
}

model Fabric {
  id           Int             @id @default(autoincrement())
  name         String          @unique
  unit         FabricUnit      @default(MTR)
  openingStock Float           @default(0)
  ratePerUnit  Float? // estimated price per unit (KG/MTR)
  // master presets — defaults applied at point of use (lay/job card), overridable
  gsm          Float?
  rollWidth    Float?
  form         FabricForm?
  // Change 36 Part 0: the deactivate fallback when a fabric is referenced and so
  // cannot be deleted. Every other master already had one (Vendor/Supplier/Buyer/
  // Colour/CuttingMaster carry `active`; Product/TrimItem use their status enum) —
  // fabric was the only one with no way to retire it.
  active       Boolean         @default(true)
  styles         Style[]
  products       Product[]
  colors         FabricColor[]
  suppliers      FabricSupplier[]
  movements      StockMovement[]
  returnNotes    ReturnNote[]
  jobFabricLines JobFabricLine[]
  fabricOrders   FabricOrder[]
  images         ImageAsset[]
  challanLines   MaterialChallanLine[]
}

// Stock is held per colour under each fabric (factory holds finished, dyed fabric
// per colour). currentStock is the authoritative snapshot (mirrors TrimItem.currentStock).
model FabricColor {
  id           Int    @id @default(autoincrement())
  color        String
  openingStock Float  @default(0)
  currentStock Float  @default(0)
  // Change 25 Part E: per-colour reorder trigger, mirroring TrimItem.reorderLevel
  // (Change 17 H). Low stock is currentStock <= reorderLevel; null = no trigger set.
  reorderLevel Float?
  fabric       Fabric @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  fabricId     Int

  // Change 25 Part A — audit stamps. `updatedAt` carries @default(now()) as well as
  // @updatedAt so the migration can backfill existing rows (SQLite rebuilds the table
  // and a bare required column would fail). Actor ids are nullable: legacy rows and
  // back-compat call paths have no session.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdBy   User?    @relation("FabricColorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?
  updatedBy   User?    @relation("FabricColorUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById Int?

  @@unique([fabricId, color])
  @@index([fabricId])
}

// Change 18 Part D/E: one sourcing-rate record per (fabric, supplier) — "rates we've
// sourced this fabric at". No longer a rival supplier identity: `supplierId` points at
// the real Supplier master. `name` is kept so legacy free-text rows still render.
// Deliberately NOT @@unique([fabricId, supplierId]) — every legacy row carries
// supplierId = null and SQLite treats NULLs as distinct, so the constraint would only
// half-apply. One-row-per-(fabric, supplier) is enforced in upsertFabricSourcingRate.
model FabricSupplier {
  id         Int       @id @default(autoincrement())
  name       String
  rate       Float?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId Int?
  poNumber   String? // provenance: the PO this rate was quoted on
  sourcedAt  DateTime?
  fabric     Fabric    @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  fabricId   Int

  @@index([fabricId])
  @@index([supplierId])
}

/// @deprecated — production styles are merged into Product (the single master).
/// Kept as a seed-time read-model; the /styles route redirects to /catalog.
model Style {
  id             Int        @id @default(autoincrement())
  styleNo        String     @unique
  sku            String?
  itemDesc       String
  mrp            Float?
  category       String?
  avgConsumption Float?
  unit           FabricUnit @default(MTR)
  fabric         Fabric?    @relation(fields: [fabricId], references: [id])
  fabricId       Int?
}

model JobCard {
  id            Int       @id @default(autoincrement())
  siNo          String
  orderDate     DateTime?
  cutQty        Float     @default(0)
  dispatchedQty Float     @default(0)

  // estimate (auto snapshot from product at create)
  estAvg           Float?
  // Change 36 Part 5: per-card override of the fabric standard. Falls back to
  // Product.avgConsumption — there is NO fabric BOM in this schema; Bom/BomLine are
  // trim-only and no BomLine ever references a Fabric.
  stdFabricPerPc Float?
  estFabric        Float?
  // actual (entered later by staff)
  actualAvg        Float?
  fabricDispatched Float?
  fabricUsed       Float?
  // legacy (historical seed data)
  avgConsumption   Float?
  fabricIssued     Float?
  fabricConsumed   Float?

  fabricIssueDate DateTime?
  cuttingIssuedOn DateTime?
  plannedEtd      DateTime?
  status          JobStatus @default(ACTIVE)
  stage           JobStage  @default(CUTTING)
  remark          String?
  trimsPending    Boolean   @default(false) // set when BOM needs exceed trim stock at save (Pending Trims)

  // header additions (Change 10, Part E) — process flags marked X on the paper form
  needsPrint   Boolean @default(false)
  needsLaser   Boolean @default(false)
  needsEmb     Boolean @default(false)
  merchandiser String? // person handling the cutting, e.g. "Jyotika"
  mrp          Float? // owner-visible only (canSeeCost)

  // made-to-order fallback (Change 12, Part D) — used when there is no catalogue product
  // (SKU shows ORDER / TBC / NEW STYLE). A job card must have either productId or customItem.
  customItem  String? // e.g. "JHARKHAND TRACKSUIT"
  customSku   String? // e.g. "ORDER" / "TBC" / a hand code
  customStyle String? // e.g. "#1202"
  customMrp   Float? // owner-visible only, when there's no product MRP

  // optional quality/quantity capture (Change 12, Part G) — never required
  rejectQty Float? // "18 PCS REJECT"
  alterQty  Float? // "262 PCS IN ALTER"
  extraQty  Float? // "39 PCS EXTRA"

  product         Product?       @relation(fields: [productId], references: [id])
  productId       Int?
  vendor          Vendor         @relation(fields: [vendorId], references: [id])
  vendorId        Int
  cuttingMaster   CuttingMaster? @relation(fields: [cuttingMasterId], references: [id])
  cuttingMasterId Int?

  dispatches        DispatchEvent[]
  sizeBreakup       SizeBreakup[]
  jobLines          JobBomLine[]
  fabricLines       JobFabricLine[]
  returnNotes       ReturnNote[]
  movements         StockMovement[]
  layers            CuttingLayer[]
  stitchAssignments StitchAssignment[]
  materialChallans  MaterialChallan[]  @relation("JobCardChallans") // Change 17 Part C
  finishingJobs     FinishingJob[] // Change 20: print/emb/wash given out per layer
  inspections       Inspection[]
  reworks           Rework[]

  // Change 25 Part A — audit stamps (see FabricColor for why @default(now()) @updatedAt).
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdBy   User?    @relation("JobCardCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?
  updatedBy   User?    @relation("JobCardUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById Int?

  @@index([vendorId])
  @@index([productId])
}

// A single lay (Change 10, Part B). A production run is cut in several layers, each
// its own colour×size table + its own fabric maths + optional date/master.
model CuttingLayer {
  id              Int            @id @default(autoincrement())
  jobCard         JobCard        @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  jobCardId       Int
  layerNo         Int // 1,2,3… order within the card
  label           String? // optional, e.g. "LAYER-1 #512"
  cutDate         DateTime? // this layer may be cut on its own date
  cuttingMaster   CuttingMaster? @relation(fields: [cuttingMasterId], references: [id])
  cuttingMasterId Int? // this layer may be cut by its own master

  // Change 14 Part A: the stitching vendor this layer was issued to (metres + bundles).
  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId Int?

  // per-layer fabric maths (Part C)
  avgConsumption Float? // m per piece, e.g. 0.781 — faint suggestion/estimate only (Change 17 A)
  rolls          Int? // roll count used, e.g. 11
  fabricMtr      Float? // Fabric USED — metres actually consumed by this lay (Change 17 A)
  fabricBalance  Float? // leftover after this layer, may be negative

  // Change 17 Part A: Fabric ISSUED to this lay (hand-entered). Extra = issued − used
  // is derived (may be negative = short-issued), never stored.
  fabricIssued Float?
  // Change 36 Part 1: this lay's job-work rate, overriding Vendor.jobRate. It lives on
  // the LAYER and not the card because a card splits across several layer vendors — a
  // card-level rate would silently bill every vendor on it the same.
  vendorRate   Float?
  // Change 36 Part 8: which fabric lot this lay was cut from. Nullable — an untagged
  // lay behaves exactly as it did before, and most legacy lays will never carry one.
  fabricLotNo  String?
  // Change 17 Part B: this lay's own editable size ratio, JSON [["S",1],["M",1.5],…].
  // null ⇒ fall back to the card ratio (back-compat for legacy layers).
  sizeRatio String?

  cells      CuttingLayerCell[]
  // Change 37: fabric issued/used per COLOUR on this lay. When these rows exist they are
  // the truth and fabricMtr/fabricIssued above are their sum; when they don't (every
  // legacy layer) the old proportional split still runs. See reconcileJobFabricColour.
  colours    CuttingLayerColour[]
  inspections Inspection[]
  reworks     Rework[]
  dispatches DispatchEvent[]    @relation("DispatchLayers") // Change 14: dispatched against these layers
  // Change 20: finishing job-work given out against this lay (same pattern as dispatch).
  finishingJobs FinishingJob[]   @relation("FinishingLayers")

  // Change 25 Part A — audit stamps.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdBy   User?    @relation("CuttingLayerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?
  updatedBy   User?    @relation("CuttingLayerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById Int?

  @@index([jobCardId])
  @@index([vendorId])
}

// Change 37 — fabric issued/used at (layer, colour) grain.
//
// Fabric physically moves colour by colour: a roll IS a colour. Until now a lay carried
// one issued and one used figure, and the per-colour stock ledger was fed by splitting
// that single number across colours BY CUT-PIECE PROPORTION — an estimate. If NAVY eats
// more metres per piece than BLACK the ledger was quietly wrong, and `Extra = issued -
// used` was a layer lump that hid which colour actually over-ran.
//
// Change 38 Part B — which of the three is TYPED changed. 37 shipped issued+used typed with
// balance derived, but the floor never measures "metres consumed": they measure what is left
// on the table. So ISSUED and BALANCE are the two a human reads off the lay, and USED is the
// one we compute (issued − balance, may be negative = mistyped/over-cut).
//
// fabricUsed is still STORED even though it is now derived, because every downstream reader —
// layerColourUsed, reconcileJobFabricColour, recordFabricActuals — drives the ledger from USED.
// Keeping the column means the flip is a UI/write-time change only, with no ledger logic touched.
//
// ⚠️ Not to be confused with CuttingLayer.fabricBalance, a hand-typed layer-level legacy field.
model CuttingLayerColour {
  id            Int          @id @default(autoincrement())
  layer         CuttingLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  layerId       Int
  colour        String // canonical colorKey, matches CuttingLayerCell.colour
  fabricIssued  Float? // typed
  fabricBalance Float? // typed  (Change 38)
  fabricUsed    Float? // DERIVED on write = issued − balance

  @@unique([layerId, colour])
  @@index([layerId])
}

model CuttingLayerCell {
  id      Int          @id @default(autoincrement())
  layer   CuttingLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  layerId Int
  colour  String // canonical colour string (colorKey, matches Change 08)
  size    String // S, M, L, XL, 2XL, 3XL …
  qty     Float

  @@index([layerId])
}

// One card's stitching can fan out to several vendors (Change 10, Part G), each with
// its own lot, received log, and derived balance; a vendor may be routed a colour.
model StitchAssignment {
  id        Int             @id @default(autoincrement())
  jobCard   JobCard         @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  jobCardId Int
  vendor    Vendor          @relation(fields: [vendorId], references: [id])
  vendorId  Int
  colour    String? // optional: this vendor stitches only this colour (e.g. "only BLACK")
  lotQty    Float? // pieces assigned to this vendor (their "LOT")
  note      String? // e.g. "stitch & finishing in Ramanreti"
  receipts  StitchReceipt[]

  @@index([jobCardId])
  @@index([vendorId])
}

model StitchReceipt {
  id           Int              @id @default(autoincrement())
  assignment   StitchAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId Int
  date         DateTime
  qty          Float
  note         String?

  @@index([assignmentId])
}

// Per-colour fabric line on a job card: one style is cut in 1–10 colours together,
// each drawing from that colour's stock. Assumed avg defaults from the product;
// actual avg + used are logged after cutting. gsm/rollWidth null ⇒ inherit the
// fabric master preset (they vary roll-to-roll, overridable at the lay).
model JobFabricLine {
  id        Int     @id @default(autoincrement())
  color     String
  fabric    Fabric  @relation(fields: [fabricId], references: [id])
  fabricId  Int
  cutQty    Float   @default(0)
  estAvg    Float?
  actualAvg Float?
  gsm       Float?
  rollWidth Float?
  qtyIssued Float?
  qtyUsed   Float?
  arrangedBy String? // who issued the fabric (defaults to logged-in user)
  challan    String?
  // fabric-detail plan per colour (Change 10, Part F)
  reqPcs    Float? // planned pieces for this colour
  reqMtr    Float? // planned fabric metres for this colour
  rolls     Int? // planned/used roll count for this colour
  imageUrl  String? // per-colour fabric swatch/photo (reuse Change 06 upload)
  jobCard   JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  jobCardId Int

  @@index([jobCardId])
  @@index([fabricId])
}

model DispatchEvent {
  id         Int            @id @default(autoincrement())
  date       DateTime
  qty        Float // event total = Σ lines.qty (kept in sync for roll-ups)
  challan    String? // legacy free-text challan ref (kept for back-compat)
  dispatchNo String?        @unique // Change 17 Part I: own "DC-2026-001" series (finished garments)
  note       String?
  // Change 22 Part B: a voided dispatch keeps its DC- number and its document (mirrors
  // MaterialChallan.voidedAt) — history is never hard-deleted. Voided events are excluded
  // from every roll-up, the vendor log, and the finished-goods export.
  voidedAt   DateTime?
  arrangedBy String? // who logged the dispatch (defaults to logged-in user)
  reason     DispatchReason @default(ORDER) // ORDER / SALE / OTHER (Change 10, Part H)
  jobCard    JobCard        @relation(fields: [jobCardId], references: [id])
  jobCardId  Int

  // Change 14 Part B: size×colour line breakup + the layers this dispatch was booked against.
  lines  DispatchLine[]
  layers CuttingLayer[] @relation("DispatchLayers")

  // Change 25 Part A — audit stamps. `arrangedBy` stays: it's free text for who physically
  // arranged the goods, which is not always the logged-in user who keyed the row.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdBy   User?    @relation("DispatchEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?
  updatedBy   User?    @relation("DispatchEventUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById Int?

  @@index([jobCardId])
}

// Change 14 Part B: one dispatched size×colour cell (colour null for SALE / defective).
model DispatchLine {
  id      Int           @id @default(autoincrement())
  event   DispatchEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int
  colour  String? // null for SALE rows (colour-less)
  size    String
  qty     Float

  @@index([eventId])
}

model SizeBreakup {
  id        Int     @id @default(autoincrement())
  size      String
  color     String  @default("") // size×color matrix; "" = colorless/legacy row
  qty       Float
  jobCard   JobCard @relation(fields: [jobCardId], references: [id])
  jobCardId Int

  @@index([jobCardId])
}

// Frozen BOM snapshot of what a job card actually consumed (immutable even if the
// product BOM later changes). Drives real-time trim depletion at job creation.
model JobBomLine {
  id          Int          @id @default(autoincrement())
  material    String
  color       String?
  dimension   BomDimension @default(FLAT)
  perPieceQty Float?
  totalQty    Float? // legacy: perPieceQty × cutQty
  requiredQty Float? // exploded need against the matrix (the amount depleted)
  issuedQty   Float?       @default(0) // logged over time; balance = requiredQty - issuedQty (derived)
  arrangedBy  String?
  issueDate   DateTime?
  challan     String?
  trimItem    TrimItem?    @relation(fields: [trimItemId], references: [id])
  trimItemId  Int?
  jobCard     JobCard      @relation(fields: [jobCardId], references: [id])
  jobCardId   Int

  @@index([jobCardId])
  @@index([trimItemId])
}

// Auto-generated when actual fabric dispatched > used. The stock add-back is a
// StockMovement RECEIPT; this is the human-facing return artifact.
model ReturnNote {
  id        Int      @id @default(autoincrement())
  qty       Float
  date      DateTime @default(now())
  note      String?
  color     String? // null for legacy/colourless returns
  fabric    Fabric   @relation(fields: [fabricId], references: [id])
  fabricId  Int
  jobCard   JobCard  @relation(fields: [jobCardId], references: [id])
  jobCardId Int

  @@index([jobCardId])
  @@index([fabricId])
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  type      MovementType
  qty       Float
  date      DateTime
  note      String?
  // Change 22 Part E: why stock moved on a hand adjustment — COUNT / DAMAGE / WASTAGE /
  // OPENING / OTHER. Null on ordinary issue/receipt traffic.
  reason    String?
  color     String? // null for legacy/colourless movements
  fabric    Fabric       @relation(fields: [fabricId], references: [id])
  fabricId  Int
  jobCard   JobCard?     @relation(fields: [jobCardId], references: [id])
  jobCardId Int?

  @@index([fabricId])
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(STAFF)
  vendorName   String? // for VENDOR role: matches Vendor.name verbatim
  // Change 36 Part 2: the owner digest had no address to go to. Nullable by design —
  // with neither set, notifications stay in-app and nothing breaks.
  phone        String?
  email        String?
  // Change 20: logins deactivate rather than delete — username is unique, so a hard
  // delete frees the name for a different person and orphans the audit trail.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  // Change 25 Part I — this staff member's signature, uploaded once and printed
  // above their name in the PO's authorised-signatory block. One image per user,
  // so a plain URL rather than an ImageAsset gallery.
  signatureUrl String?

  // Change 25 Part I — POs this person raised (their authorised signature).
  fabricOrdersPlaced FabricOrder[] @relation("FabricOrderPlacedBy")
  trimOrdersPlaced   TrimOrder[]   @relation("TrimOrderPlacedBy")

  // Change 25 Part A — the actor side of every audit stamp. Named relations only
  // because a model can point at User twice (created/updated); nothing reads these
  // back-relations today, they exist to satisfy Prisma.
  auditLogs           AuditLog[]
  jobCardsCreated     JobCard[]         @relation("JobCardCreatedBy")
  jobCardsUpdated     JobCard[]         @relation("JobCardUpdatedBy")
  challansCreated     MaterialChallan[] @relation("MaterialChallanCreatedBy")
  challansUpdated     MaterialChallan[] @relation("MaterialChallanUpdatedBy")
  dispatchesCreated   DispatchEvent[]   @relation("DispatchEventCreatedBy")
  dispatchesUpdated   DispatchEvent[]   @relation("DispatchEventUpdatedBy")
  layersCreated       CuttingLayer[]    @relation("CuttingLayerCreatedBy")
  layersUpdated       CuttingLayer[]    @relation("CuttingLayerUpdatedBy")
  fabricOrdersCreated FabricOrder[]     @relation("FabricOrderCreatedBy")
  fabricOrdersUpdated FabricOrder[]     @relation("FabricOrderUpdatedBy")
  trimOrdersCreated   TrimOrder[]       @relation("TrimOrderCreatedBy")
  trimOrdersUpdated   TrimOrder[]       @relation("TrimOrderUpdatedBy")
  fabricColorsCreated FabricColor[]     @relation("FabricColorCreatedBy")
  partyLedgerEntries PartyLedgerEntry[] @relation("PartyLedgerCreatedBy")
  notifications      Notification[]     @relation("NotificationUser")
  inspections        Inspection[]       @relation("InspectionBy")
  samplesRequested   Sample[]           @relation("SampleRequestedBy")
  notificationPrefs  NotificationPref[] @relation("NotificationPrefUser")
  fabricColorsUpdated FabricColor[]     @relation("FabricColorUpdatedBy")
  trimItemsCreated    TrimItem[]        @relation("TrimItemCreatedBy")
  trimItemsUpdated    TrimItem[]        @relation("TrimItemUpdatedBy")

  @@index([role])
}

// Change 25 Part A — append-only accountability log. Written inside the same
// $transaction as the mutation it describes (see src/lib/audit.ts), so the log and
// the change commit together or not at all.
//
// `username` is denormalised on purpose: `userId` goes null when a login is deleted,
// and "who did this" must survive that. `changes` / `meta` are JSON *strings* — this
// schema stores JSON as TEXT everywhere (see CuttingLayer.sizeRatio), no Prisma Json.
// ── Change 36 Part 2 — outbound notifications ──
// ★ ONE gateway, many triggers. Transport is swappable and defaults to LOG-ONLY: every
// send is recorded here whether or not anything left the building, so the factory gets a
// working in-app inbox with zero external setup, and wiring a real WhatsApp/SMTP
// transport later changes one file rather than every call site.
model Notification {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  to       String // resolved address, or the party name when log-only
  channel  String // WHATSAPP | EMAIL | INAPP
  template String // po.shared, card.routed, stock.low, …
  body     String
  entity   String?
  entityId String?
  status   String   @default("QUEUED") // QUEUED | SENT | FAILED | READ
  error    String?

  // Who should see this in their inbox. Null = the owner/admin inbox.
  user   User? @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  userId Int?

  @@index([userId])
  @@index([at])
  @@index([template])
}

// Per-user, per-event, per-channel opt-in. Absent row = the template's own default.
model NotificationPref {
  id       Int     @id @default(autoincrement())
  user     User    @relation("NotificationPrefUser", fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  template String
  channel  String
  enabled  Boolean @default(true)

  @@unique([userId, template, channel])
  @@index([userId])
}

// ── Change 36 Part 3 — quality: a gate that records and warns, never blocks ──
// ★ The gate NEVER hard-blocks the floor. Dispatching un-inspected or failed pieces is
// allowed; it shows a confirm and is recorded. A factory that cannot ship because the
// software disagrees is a factory that stops using the software.
enum DefectCategory {
  STITCHING
  PRINTING
  FABRIC
  MEASUREMENT
  FINISHING
  OTHER
}

enum InspectionResult {
  PASS
  FAIL
  PARTIAL
}

enum ReworkStatus {
  OPEN
  CLOSED
}

model DefectType {
  id       Int            @id @default(autoincrement())
  name     String         @unique
  category DefectCategory @default(OTHER)
  active   Boolean        @default(true)
  lines    InspectionDefect[]
}

model Inspection {
  id           Int              @id @default(autoincrement())
  at           DateTime         @default(now())
  jobCard      JobCard          @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  jobCardId    Int
  layer        CuttingLayer?    @relation(fields: [layerId], references: [id], onDelete: SetNull)
  layerId      Int?
  inspectedBy   User?           @relation("InspectionBy", fields: [inspectedById], references: [id], onDelete: SetNull)
  inspectedById Int?
  sampleSize   Int?
  checkedQty   Float            @default(0)
  passQty      Float            @default(0)
  rejectQty    Float            @default(0)
  reworkQty    Float            @default(0)
  result       InspectionResult @default(PASS)
  note         String?
  // Voided rather than deleted, exactly like a challan — the count it produced may
  // already have been read, so the row stays and stops counting.
  voidedAt     DateTime?
  defects      InspectionDefect[]

  @@index([jobCardId])
  @@index([layerId])
}

model InspectionDefect {
  id           Int        @id @default(autoincrement())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId Int
  defectType   DefectType @relation(fields: [defectTypeId], references: [id])
  defectTypeId Int
  qty          Float      @default(0)

  @@index([inspectionId])
}

// Rework is a TRACKING movement, not a stock movement. It must never reach
// postMaterialMovement: finished-goods stock lives in the ERP, and pieces going back to
// a vendor for repair have not left the factory's ownership.
model Rework {
  id        Int          @id @default(autoincrement())
  docNo     String?      @unique // "RW-YYYY-NNN" — its own series; JW- is a billing doc
  at        DateTime     @default(now())
  jobCard   JobCard      @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  jobCardId Int
  layer     CuttingLayer? @relation(fields: [layerId], references: [id], onDelete: SetNull)
  layerId   Int?
  vendor    Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorId  Int?
  qty       Float
  qtyBack   Float        @default(0)
  status    ReworkStatus @default(OPEN)
  note      String?

  @@index([jobCardId])
  @@index([vendorId])
}

// ── Change 36 Part 7 — sampling & development ──
//
// ⚠️ NOT SamplingStatus. That enum has four values — PLANNING,
// DESIGN_FABRIC_PENDING, SAMPLE_ORDERED, READY — none of which can express approve or
// reject, and it is a PRODUCT column describing where a style sits in development, not a
// sample's lifecycle. Extending it would put sample states onto every product.
enum SampleStatus {
  REQUESTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum SampleCostKind {
  FABRIC
  TRIM
  CUTTING
  STITCHING
  FINISHING
  OVERHEAD
  OTHER
}

// ★ The sample is a first-class document that GRADUATES into a job card. Everything
// ssfact does starts after a style is approved — but the money-losing decisions happen
// before.
model Sample {
  id          Int          @id @default(autoincrement())
  code        String       @unique // SMP-YYYY-NNN, allocated inside the transaction
  name        String
  round       Int          @default(1)
  status      SampleStatus @default(REQUESTED)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   Int?
  vendor      Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorId    Int?
  requestedBy   User?      @relation("SampleRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedById Int?
  notes       String?
  /** Set when APPROVED/REJECTED, with the remark that decided it. */
  decidedAt   DateTime?
  remark      String?
  targetMrp   Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  costLines    SampleCostLine[]
  measurements SampleMeasurement[]
  images       ImageAsset[]

  @@index([productId])
  @@index([status])
}

model SampleCostLine {
  id          Int            @id @default(autoincrement())
  sample      Sample         @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  sampleId    Int
  kind        SampleCostKind @default(OTHER)
  description String
  qty         Float          @default(1)
  rate        Float          @default(0)

  @@index([sampleId])
}

// The size × point-of-measure table. It has no home anywhere else in the schema and the
// tech pack cannot be printed without it.
model SampleMeasurement {
  id        Int    @id @default(autoincrement())
  sample    Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  sampleId  Int
  pom       String // "Chest", "Sleeve length", …
  size      String
  valueCm   Float
  tolerance Float?

  @@index([sampleId])
}

// ── Change 36 Part 10 — offline write replay ──
// ★ Degrade, don't die. A floor write made offline is queued in the browser with a
// client-generated key and replayed on reconnect. The key is the ONLY thing standing
// between a flaky connection and a double-posted stock movement, so the server records
// every key it has honoured along with the result it returned, and a replay returns that
// result instead of doing the work again.
model IdempotencyRecord {
  key        String   @id // client-generated (crypto.randomUUID)
  action     String
  userId     Int?
  username   String // denormalised, like AuditLog — the row outlives the user
  resultJson String?
  at         DateTime @default(now())

  @@index([at])
}

model AuditLog {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      Int?
  username    String
  action      String // "voidDispatch" | "adjustFabricStock" | …  (the action's own name)
  entity      String // "DispatchEvent" | "JobCard" | …
  entityId    String
  entityLabel String? // "DC-2026-014" / "SI-1188" — what a human calls the row
  summary     String // "Voided DC-2026-014, +12 pcs back to SI-1188"
  changes     String? // JSON Record<field, { old, new }>
  meta        String? // JSON free-form before/after snapshot

  @@index([entity, entityId])
  @@index([userId])
  @@index([at])
  @@index([action])
}

// ── Product = the single master (commercial catalog + production spec) ──
model Product {
  id           Int           @id @default(autoincrement())
  extId        String        @unique
  skuCode      String
  normSku      String
  styleNo      String?
  name         String
  itemDesc     String? // workbook item description (for job autofill + list "item")
  headCategory String?
  mrp          Float?
  customWsRate Float?
  status       ProductStatus @default(ACTIVE)
  styleGroup   String?
  bomCode      String?

  // production-master fields (merged from Style)
  avgConsumption Float?
  unit           FabricUnit @default(MTR)
  fabric         Fabric?    @relation(fields: [fabricId], references: [id])
  fabricId       Int?
  imageUrl       String?
  sizeRatioJson  String? // JSON [["S",0.08],...] — per-product configurable size ratio
  colorRatioJson String? // JSON [["RED",0.5],...] — default color split
  // production/sampling attributes (Change 07 — from Notion product master)
  samplingStatus SamplingStatus?
  productionLot  ProductionLot?
  fabricRemarks  String?
  otherRemarks   String?

  colors           ProductColor[]
  jobCards         JobCard[]
  boms             Bom[]
  productionOrders ProductionOrder[]
  samples          Sample[]
  images           ImageAsset[]

  @@index([headCategory])
  @@index([normSku])
  @@index([fabricId])
}

model ProductColor {
  id        Int     @id @default(autoincrement())
  name      String
  hex       String?
  sortOrder Int?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@unique([productId, name])
  @@index([productId])
}

model Bom {
  id        Int       @id @default(autoincrement())
  code      String
  styleName String
  product   Product?  @relation(fields: [productId], references: [id])
  productId Int?
  lines     BomLine[]

  @@index([productId])
}

model BomLine {
  id          Int          @id @default(autoincrement())
  sNo         Int?
  material    String
  color       String?
  qty         Float? // legacy per-piece qty (kept for migration)
  perPieceQty Float? // source going forward (per-one-piece count)
  dimension   BomDimension @default(FLAT)
  avg         String?
  bom         Bom          @relation(fields: [bomId], references: [id])
  bomId       Int
  trimItem    TrimItem?    @relation(fields: [trimItemId], references: [id])
  trimItemId  Int?

  @@index([bomId])
  @@index([trimItemId])
}

model TrimItem {
  id           Int            @id @default(autoincrement())
  sno          String?
  name         String         @unique
  normName     String
  family       String? // legacy free-text family (kept for back-compat)
  openingStock Float          @default(0)
  currentStock Float          @default(0) // authoritative snapshot
  // unified trim master fields
  category     TrimCategory?
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  supplierId   Int?
  ratePerUnit  Float?
  unit         String? // pcs / mtr / kg / set (Change 17 H: growing dropdown via Lookup UNIT)
  status       TrimStatus     @default(ACTIVE)
  remarks      String?
  imageUrl     String?
  // Change 17 Part D: "applies to" + per-piece average defined ONCE on the master;
  // the trim sheet rolls these up (no re-entry on the job card). Nullable = no preset.
  dimension    BomDimension?
  perPieceAvg  Float?
  // Change 17 Part H: per-trim reorder trigger; low-stock when currentStock <= reorderLevel.
  reorderLevel Float?
  // optional spec fields (surfaced per category, never forced)
  size          String?
  material      String?
  weight        String?
  shape         String?
  color         String?
  estMonthlyReq Float? // OWNER-PLANNING only — hidden from the staff entry form
  movements    TrimMovement[]
  bomLines     BomLine[]
  jobLines     JobBomLine[]
  images       ImageAsset[]
  challanLines MaterialChallanLine[]
  orders       TrimOrder[] // Change 18 Part B

  // Change 25 Part A — audit stamps.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdBy   User?    @relation("TrimItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?
  updatedBy   User?    @relation("TrimItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById Int?

  @@index([normName])
  @@index([family])
  @@index([category])
  @@index([supplierId])
}

// Shared supplier master (fabric orders + every trim category point here).
model Supplier {
  ledgerEntries PartyLedgerEntry[]
  id           Int           @id @default(autoincrement())
  name         String        @unique
  type         SupplierType?
  city         String?
  phone        String? // the firm's main line; named people live in contacts[]
  address      String? // for the PO document
  email        String? // for the PO email (mailto)
  // Change 25 Part G.1: GSTIN, printed on the PO document.
  gstNo        String?
  remarks      String?
  active           Boolean           @default(true)
  trims            TrimItem[]
  fabricOrders     FabricOrder[]
  materialChallans MaterialChallan[]
  // Change 18 Part B/D: trim purchase orders + the per-fabric sourcing-rate records
  // that used to live under a free-text name.
  trimOrders       TrimOrder[]
  fabricSuppliers  FabricSupplier[]
  // Change 25 Part G.0
  contacts         Contact[]

  @@index([type])
}

/**
 * Change 25 Part G.0 — named people at a supplier or a buyer firm.
 *
 * The floor team needs to know WHO to call and in what capacity, not just a
 * number on the letterhead. Rendered everywhere as `name (role)` —
 * "Ramesh (Owner)", "Priya (Accounts)".
 *
 * One child table serves both parents through nullable FKs, the same
 * one-table-serves-many pattern as ImageAsset. The parent's own phone/email stay
 * as the main line for back-compat.
 */
model Contact {
  id         Int       @id @default(autoincrement())
  name       String
  role       String? // "Owner" | "Accounts" | "Dispatch" | free text — shown in ()
  phone      String?
  email      String?
  sortOrder  Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId Int?
  buyer      Buyer?    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId    Int?

  @@index([supplierId])
  @@index([buyerId])
}

/**
 * Change 25 Part G.2 — the firm a purchase order is issued FROM.
 *
 * Not an end customer: end-buyer/sales management stays in the separate B2B app.
 * This is the factory's own bill-from / ship-from identity. The owner runs three
 * or four firms and must choose which one a PO goes out under, with that firm's
 * GST, billing address and one of its delivery addresses.
 */
model Buyer {
  id             Int                    @id @default(autoincrement())
  name           String                 @unique
  gstNo          String?
  city           String?
  buyerAddress   String? // main / registered address
  billingAddress String? // the second address — where the bill goes
  active         Boolean                @default(true)
  contacts       Contact[]
  deliveryAddrs  BuyerDeliveryAddress[]
  fabricOrders   FabricOrder[]
  trimOrders     TrimOrder[]
}

/**
 * A delivery address must be its own table, not a field: a PO references ONE
 * specific address by FK, and the set changes over time.
 */
model BuyerDeliveryAddress {
  id      Int     @id @default(autoincrement())
  buyer   Buyer   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId Int
  label   String? // "Warehouse", "Unit 2"
  address String
  active  Boolean @default(true)

  fabricOrders FabricOrder[]
  trimOrders   TrimOrder[]

  @@index([buyerId])
}

// Global colour master (Change 08) — powers the colour dropdown; order lines store a string.
model Colour {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  hex       String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Generic master for every simple reusable dropdown list (Change 09). Stable `code`
// (never changes), editable `label`. parentId gives category → sub-category.
enum LookupKind {
  HEAD_CATEGORY
  SUB_CATEGORY
  UNIT
  SUPPLIER_TYPE
  TRIM_CATEGORY
  STYLE_GROUP
}

model Lookup {
  id        Int        @id @default(autoincrement())
  kind      LookupKind
  code      String
  label     String
  hex       String?
  parentId  Int?
  parent    Lookup?    @relation("LookupTree", fields: [parentId], references: [id])
  children  Lookup[]   @relation("LookupTree")
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  @@unique([kind, code])
  @@index([kind, parentId])
}

// Procurement pipeline that feeds fabric INTO colour stock.
model FabricOrder {
  id            Int               @id @default(autoincrement())
  fabric        Fabric            @relation(fields: [fabricId], references: [id])
  fabricId      Int
  color         String? // legacy single-colour (pre-Change-08 rows); new orders use lines[]
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  supplierId    Int?
  qty           Float // legacy total; new orders derive total from lines
  unit          FabricUnit        @default(MTR)
  rate          Float?
  gsm           Float?
  colorCount    Int?
  status        FabricOrderStatus @default(PLANNING)
  shadeCardDone Boolean           @default(false)
  orderDate     DateTime?
  expectedDate  DateTime?
  receivedDate  DateTime? // set on receive — also the double-receive guard
  remarks       String?
  // PO (Change 08)
  poNumber      String?           @unique // e.g. PO-2026-001 — set when PO generated, locks the order
  poGeneratedAt DateTime?
  sentAt        DateTime? // set when emailed/WhatsApp-shared
  lines         FabricOrderLine[]
  images        ImageAsset[]
  // Change 18 Part C: the inward challans this PO was received on.
  challans      MaterialChallan[]

  // Change 25 Part G.3 — which of our firms this PO is issued from, and to which
  // of its delivery addresses. Nullable so every existing order still prints.
  buyer             Buyer?                @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerId           Int?
  deliveryAddress   BuyerDeliveryAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  deliveryAddressId Int?
  // Change 25 Part I — the staff member who raised the PO, i.e. its authorised
  // signatory. Distinct from createdById: a PO can be generated later, by someone
  // other than whoever drafted the order.
  placedBy          User?                 @relation("FabricOrderPlacedBy", fields: [placedById], references: [id], onDelete: SetNull)
  placedById        Int?
  // Change 38 Part F — the PO's authorised signatory is a contact of the issuing firm
  // (Buyer.contacts), not a login user. Stored as a NAME SNAPSHOT rather than a contact FK
  // on purpose: updateBuyer replaces a buyer's contacts wholesale on every save, so their
  // ids churn and an FK would silently SetNull the signatory off an already-issued PO.
  // placedById stays for the audit of who generated it.
  signatoryName     String?
  // Change 25 Part K.2 — GST %, stored so a reprint is identical.
  gstRate           Float?

  // Change 25 Part A — audit stamps.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdBy   User?    @relation("FabricOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?
  updatedBy   User?    @relation("FabricOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById Int?

  @@index([fabricId])
  @@index([supplierId])
  @@index([status])
}

// One colour + quantity row of a multi-colour fabric order (Change 08).
model FabricOrderLine {
  id            Int         @id @default(autoincrement())
  fabricOrder   FabricOrder @relation(fields: [fabricOrderId], references: [id], onDelete: Cascade)
  fabricOrderId Int
  colour        String // canonical colour string (colorKey)
  qty           Float

  @@index([fabricOrderId])
}

// Change 18 Part B: trim procurement — the mirror of FabricOrder, so trims are bought
// the same way fabric is. Own PO series (POT-YYYY-NNN); goods still enter stock only by
// locking the inward challan raised against this order. `status` deliberately reuses
// FabricOrderStatus (SQLite stores enums as TEXT — a duplicate enum buys nothing).
model TrimOrder {
  id            Int               @id @default(autoincrement())
  trimItem      TrimItem          @relation(fields: [trimItemId], references: [id])
  trimItemId    Int
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  supplierId    Int?
  qty           Float // total; derived from lines[] when the order is split
  unit          String? // matches the trim master's unit (pcs / mtr / kg / set)
  rate          Float?
  status        FabricOrderStatus @default(ORDER_PLACED)
  orderDate     DateTime?
  expectedDate  DateTime?
  receivedDate  DateTime?
  remarks       String?
  poNumber      String?           @unique // POT-2026-001
  poGeneratedAt DateTime?
  sentAt        DateTime?
  lines         TrimOrderLine[]
  challans      MaterialChallan[]

  // Change 25 Parts G.3 / I / K.2 — mirror of FabricOrder.
  buyer             Buyer?                @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerId           Int?
  deliveryAddress   BuyerDeliveryAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  deliveryAddressId Int?
  placedBy          User?                 @relation("TrimOrderPlacedBy", fields: [placedById], references: [id], onDelete: SetNull)
  placedById        Int?
  // Change 38 Part F — see FabricOrder.signatoryName.
  signatoryName     String?
  gstRate           Float?
  // Change 25 Part H.2 — sample photos against a trim order.
  images            ImageAsset[]

  // Change 25 Part A — audit stamps.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdBy   User?    @relation("TrimOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?
  updatedBy   User?    @relation("TrimOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById Int?

  @@index([trimItemId])
  @@index([supplierId])
  @@index([status])
}

// Optional colour/size split of a trim order (buttons in 3 colours, tags in 2 sizes).
// A plain qty order carries no lines at all.
model TrimOrderLine {
  id          Int       @id @default(autoincrement())
  trimOrder   TrimOrder @relation(fields: [trimOrderId], references: [id], onDelete: Cascade)
  trimOrderId Int
  colour      String?
  size        String?
  qty         Float

  @@index([trimOrderId])
}

model TrimMovement {
  id         Int          @id @default(autoincrement())
  type       MovementType
  qty        Float
  date       DateTime?
  invoice    String?
  rate       Float?
  vendor     String?
  // Change 22 Part E: trims finally carry the same note + adjustment reason fabric has,
  // so postMaterialMovement stops silently dropping the note on the trim branch.
  note       String?
  reason     String?
  trimItem   TrimItem     @relation(fields: [trimItemId], references: [id])
  trimItemId Int

  @@index([trimItemId])
}

// Generic image gallery — nullable FKs let one table serve every entity, many per entity.
model ImageAsset {
  id        Int      @id @default(autoincrement())
  url       String
  thumbUrl  String?
  caption   String?
  kind      String? // "product" | "swatch" | "shade_card" | "trim"
  sortOrder Int?
  createdAt DateTime @default(now())

  trimItem      TrimItem?    @relation(fields: [trimItemId], references: [id], onDelete: Cascade)
  trimItemId    Int?
  fabric        Fabric?      @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  fabricId      Int?
  fabricOrder   FabricOrder? @relation(fields: [fabricOrderId], references: [id], onDelete: Cascade)
  fabricOrderId Int?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     Int?
  // Change 25 Part H — two more attach points. Each needs its own nullable FK
  // (that is how the gallery stays queryable per entity), so we add exactly the
  // two that earn it rather than a loose polymorphic blob: a trim order's sample
  // photo, and the paper delivery challan snapped against an inward receipt.
  trimOrder        TrimOrder?       @relation(fields: [trimOrderId], references: [id], onDelete: Cascade)
  trimOrderId      Int?
  materialChallan  MaterialChallan? @relation(fields: [materialChallanId], references: [id], onDelete: Cascade)
  materialChallanId Int?

  @@index([trimItemId])
  @@index([fabricId])
  @@index([fabricOrderId])
  @@index([productId])
  @@index([trimOrderId])
  @@index([materialChallanId])
  // Change 36 Part 7: a 7th nullable owner. Deliberately NOT a separate SampleImage
  // model — that would fork the ImageUploader/attachImages/removeImage pipeline.
  sample   Sample? @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  sampleId Int?

}

model ProductionOrder {
  id             Int              @id @default(autoincrement())
  orderNo        String           @unique
  product        Product          @relation(fields: [productId], references: [id])
  productId      Int
  orderDate      DateTime?
  targetQty      Float
  avgMonthlySale Float?
  status         ProductionStatus @default(ORDER_GIVEN)
  urgency        String?
  remarks        String?

  @@index([productId])
}

// Standalone materials challan (Change 11) — inward (from supplier) / outward (to vendor)
// for fabric + trims + accessories, independent of any job card. Posts to the ONE master
// inventory ledger on lock.
model MaterialChallan {
  id        Int              @id @default(autoincrement())
  direction ChallanDirection
  status    ChallanStatus    @default(DRAFT)
  challanNo String?          @unique // e.g. "CH-OUT-2026-001" / "CH-IN-2026-001" (set on lock)
  date      DateTime         @default(now())

  // Change 17 Part C: derived kind (FABRIC/TRIM/COMBINED) — null for legacy rows.
  kind ChallanKind?
  // Change 17 Part C: the job card this challan is raised against ("master head").
  // Optional for FABRIC (pure stock purchase); expected (warned in UI) for TRIM/COMBINED.
  jobCard   JobCard? @relation("JobCardChallans", fields: [jobCardId], references: [id])
  jobCardId Int?

  // counterparty: exactly one side is set based on direction
  supplier   Supplier? @relation(fields: [supplierId], references: [id]) // INWARD
  supplierId Int?
  vendor     Vendor?   @relation(fields: [vendorId], references: [id]) // OUTWARD
  vendorId   Int?

  // Change 18 Part C: the purchase order this inward challan received against — the link
  // that makes "did this PO come in, and on what challan?" answerable. Both null for an
  // ad-hoc challan raised without a PO.
  fabricOrder   FabricOrder? @relation(fields: [fabricOrderId], references: [id], onDelete: SetNull)
  fabricOrderId Int?
  trimOrder     TrimOrder?   @relation(fields: [trimOrderId], references: [id], onDelete: SetNull)
  trimOrderId   Int?

  note      String?
  lockedAt  DateTime?
  voidedAt  DateTime?
  lines     MaterialChallanLine[]
  createdAt DateTime              @default(now())
  // Change 25 Part H.3 — proof photo of the paper challan / received bundle.
  images    ImageAsset[]

  // Change 25 Part D — purchase return. A return is an OUTWARD challan whose
  // counterparty is a supplier, pointing back at the inward challan the goods
  // arrived on. It is NOT a void: voiding says the receipt never happened and
  // rolls the PO back; a return says we received the goods, kept them, and later
  // sent them back — so the PO stays RECEIVED and this is a new movement.
  // Its number comes from its own CH-RET- series (see lockChallan).
  returnOf         MaterialChallan?  @relation("ChallanReturns", fields: [returnOfChallanId], references: [id], onDelete: SetNull)
  returnOfChallanId Int?
  returns          MaterialChallan[] @relation("ChallanReturns")
  /** DEFECT | WRONG_ITEM | EXCESS | OTHER — validated in the action, like AdjustReason. */
  returnReason     String?

  // Change 25 Part A — audit stamps.
  updatedAt   DateTime @default(now()) @updatedAt
  createdBy   User?    @relation("MaterialChallanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?
  updatedBy   User?    @relation("MaterialChallanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById Int?

  @@index([direction])
  @@index([vendorId])
  @@index([supplierId])
  @@index([jobCardId])
  @@index([fabricOrderId])
  @@index([trimOrderId])
}

model MaterialChallanLine {
  id        Int             @id @default(autoincrement())
  challan   MaterialChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  challanId Int

  // a line is EITHER a fabric line (with colour) OR a trim/accessory line
  fabric     Fabric?   @relation(fields: [fabricId], references: [id])
  fabricId   Int?
  colour     String? // for fabric lines (colorKey, matches Change 08)
  trimItem   TrimItem? @relation(fields: [trimItemId], references: [id])
  trimItemId Int?

  qty  Float
  unit String? // MTR / KG / PCS / SET
  rate Float? // optional ₹/unit
  note String?

  @@index([challanId])
  @@index([fabricId])
  @@index([trimItemId])
  lotNo     String?
  shadeRef  String?

}

// ── Change 20 — finishing as job-work ────────────────────────────────────────
//
// Finishing (print / embroidery / wash / sublimation) is real work the factory gives
// OUT to a vendor and gets BACK, mostly layer by layer. The software only carried three
// booleans on the job card, which recorded THAT finishing was needed but not who did it,
// which layers went out, or how much came back — so "every job-work I gave vendor X,
// with bills and quantities sorted" was unanswerable.
//
// It mirrors the dispatch model (events linked to layers), so it rides a proven pattern.
//
// ★ This is a TRACKING ledger, not a stock ledger. Finished garments live in the ERP
// (Change 21) and fabric/trims were deducted upstream (Change 19). A FinishingJob must
// never touch FabricColor.currentStock, TrimItem.currentStock or JobCard.dispatchedQty.

enum FinishingProcess {
  PRINT
  EMBROIDERY
  WASH
  SUBLIMATION
  LASER
  OTHER
}

enum FinishingStatus {
  OPEN // issued (qty out), not fully back
  CLOSED // fully received back
}

model FinishingJob {
  id      Int              @id @default(autoincrement())
  docNo   String?          @unique // "JW-2026-001" — allocated on issue (mirrors DC-/CH-)
  process FinishingProcess
  status  FinishingStatus  @default(OPEN)

  vendor    Vendor  @relation(fields: [vendorId], references: [id])
  vendorId  Int
  jobCard   JobCard @relation(fields: [jobCardId], references: [id])
  jobCardId Int

  // usually layer-wise; may span several layers of the same card (same pattern as DispatchLayers)
  layers CuttingLayer[] @relation("FinishingLayers")

  issuedDate   DateTime  @default(now())
  receivedDate DateTime? // set on the first receipt
  qtyOut       Float // pieces sent for finishing
  qtyBack      Float     @default(0) // accumulates across receipts; may differ from out

  // commercial tracking so vendor bills reconcile
  rate   Float? // ₹ per piece (owner-visible only, canSeeCost)
  billNo String? // vendor's bill/invoice ref
  note   String?

  // optional size×colour breakup of what went out; the header qty is authoritative
  lines FinishingJobLine[]

  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([jobCardId])
  @@index([process])
}

model FinishingJobLine {
  id      Int          @id @default(autoincrement())
  job     FinishingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId   Int
  colour  String? // colorKey; null = colour-less
  size    String
  qtyOut  Float
  qtyBack Float        @default(0)

  @@index([jobId])
}
